# Copy to .env (gitignored) and fill in locally. Never commit .env.
GEMINI_API_KEY=
DATABASE_URL=
# disabled by default; "demo" enables SHA-256-matched synthetic fixture answers only.
EXTRACTOR_MODE=disabled
MAX_UPLOAD_MB=5
MAX_OUTPUT_TOKENS=800
MAX_TURNS_PER_SESSION=30
# Per-process limit based on the direct client address; forwarded headers are ignored.
RATE_LIMIT_PER_MIN=20
UPLOAD_RETENTION_MINUTES=60
